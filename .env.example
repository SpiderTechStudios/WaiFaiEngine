APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform billing (pay-first enrollment + installation)
PLATFORM_CURRENCY=TZS
PLATFORM_SUBSCRIPTION_MONTHLY=10000
PLATFORM_SUBSCRIPTION_GRACE_DAYS=7
PLATFORM_INSTALLATION_ONLY=100000
PLATFORM_ROUTER_AND_INSTALLATION=150000
PLATFORM_ENROLLMENT_TTL_MINUTES=4
PLATFORM_ENROLLMENT_MAX_FAILED_ATTEMPTS=3
PLATFORM_PAYMENT_WEBHOOK_SECRET=
PLATFORM_PAYMENT_AUTO_PAID=false

# Captive portal / WiFiDog
# API: https://waifai.shereheyangu.com
# Frontend connect page (NOT the WiFiDog API):
CAPTIVE_SESSION_TTL=30
CAPTIVE_PORTAL_URL=https://waifai.cloud.shereheyangu.com/connect
FRONTEND_URL=https://waifai.cloud.shereheyangu.com
CAPTIVE_PORTAL_CONNECT_PATH=/connect
#
# Ruijie/WiFiDog AuthServer Path must be /api/wifidog/ (not /api/wifidog/login/)
# or the phone will request /api/wifidog/login/login and get 404.
#
# After payment, the connect UI MUST open data.gateway_auth_url
# (http://{AP_LAN_IP}:2060/wifidog/auth?token=...) or the AP never grants internet.
#
# Where the gateway's portal/ script sends the browser after "Auth: 1".
# We redirect to the original requested URL, or this URL when none was captured.
CAPTIVE_PORTAL_SUCCESS_URL=http://www.google.com

# Flutterwave V3 (seeded into payment_providers; secrets encrypted at rest)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-274a977b8810f00b9992d4ff70846b7b-X
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# PalmPay merchant API (seeded as active; set default via admin dashboard)
# Webhook URL to register in PalmPay: {APP_URL}/api/v1/webhooks/payments/palmpay
PALMPAY_APP_ID=
PALMPAY_PRIVATE_KEY=
PALMPAY_PUBLIC_KEY=
PALMPAY_COUNTRY_CODE=NG
PALMPAY_VERSION=V2
PALMPAY_BASE_URL=https://open-gw-prod.palmpay-inc.com
# Sandbox (if enabled for your merchant): https://open-gw-daily.palmpay-inc.com

# PalmPesa Tanzania mobile money (https://documentation.palmpesa.co.tz/#getting-started)\r\n# Credentials are env-only (not stored on payment_providers).\r\n# Callback URL: {APP_URL}/api/v1/webhooks/payments/palmpesa
# Pending payments are polled via order-status after PALMPESA_STATUS_CHECK_MINUTES (default 4)
PALMPESA_API_TOKEN=
PALMPESA_USER_ID=
PALMPESA_BASE_URL=https://palmpesa.drmlelwa.co.tz
PALMPESA_STATUS_CHECK_MINUTES=4
PALMPESA_VENDOR=TILL61103867